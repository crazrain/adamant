+    check(cached >= 0, "reopen cached descriptor");
+    char byte = 0;
+    const int64_t got = fp::pread(cached, &byte, 1, page + 1);
+    fp::close_fd(cached);
+    check(got == 1 && byte == expected[page + 1], "reused descriptor kept direct mode");
